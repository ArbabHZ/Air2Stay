# ============================================================================
# Air2Stay .gitignore - Confidential Data & Build Artifacts
# ============================================================================

# CRITICAL: Data Files (Proprietary DCT Data)
# ============================================================================
data/
*.xlsx
*.xls
*.csv
!requirements.txt  # Exception: requirements.txt is tracked

# Generated Model Outputs
# ============================================================================
prototype/data/scenario_data.json
prototype/data/*.json
outputs/
outputs/model/*.csv
outputs/model/*.json
deliverables/
*.json
!package.json
!*.example.json
!prototype/data/scenario_data.json

# Python
# ============================================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
venv/
ENV/
env/
.venv
pip-log.txt
pip-delete-this-directory.txt

# IDE & Text Editors
# ============================================================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.project
.pydevproject
.settings/
*.sublime-project
*.sublime-workspace
.vim/
*.code-workspace

# Testing & Coverage
# ============================================================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/
.mypy_cache/
.dmypy.json
dmypy.json

# Node.js
# ============================================================================
node_modules/
npm-debug.log
yarn-error.log
package-lock.json
yarn.lock
.npm

# Windows-specific
# ============================================================================
Thumbs.db
ehthumbs.db
.lnk

# macOS-specific
# ============================================================================
.AppleDouble
.LSOverride
._*

# Temporary & Backup Files
# ============================================================================
*.tmp
*.temp
*.bak
*.backup
*~
.~*
*.swp
*.swo
\#*\#
.\#*

# Environment Variables
# ============================================================================
.env
.env.local
.env.*.local

# Sensitive Overrides (Never Commit)
# ============================================================================
planner_overrides.json
override_weights.json
test_credentials.*

# Development
# ============================================================================
.eslintcache
.stylelintcache
*.log
*.prof

# Docker (if added later)
# ============================================================================
.dockerignore
docker-compose.override.yml

# Required bundled assets for the Streamlit deployment
!prototype/data/
!prototype/data/scenario_data.json
!prototype/data/admin0-countries.svg
